{
  "name": "pdir/contao-right-of-withdrawal-bundle",
  "type": "contao-bundle",
  "description": "Electronic withdrawal and cancellation buttons for Contao: § 356a BGB (\"Vertrag widerrufen\"), § 312k BGB (\"Verträge hier kündigen\") and § 13a FAGG.",
  "keywords": [
    "contao",
    "widerrufsbutton",
    "kuendigungsbutton",
    "withdrawal",
    "cancellation",
    "isotope",
    "356a-bgb",
    "312k-bgb",
    "13a-fagg"
  ],
  "license": "LGPL-3.0-or-later",
  "authors": [
    {
      "name": "pdir GmbH",
      "homepage": "https://pdir.de"
    }
  ],
  "require": {
    "php": "^8.1",
    "contao/core-bundle": "^5.3 || ^6.0",
    "doctrine/dbal": "^3.6 || ^4.0",
    "symfony/config": "^6.4 || ^7.4 || ^8.0",
    "symfony/console": "^6.4 || ^7.4 || ^8.0",
    "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.0",
    "symfony/http-foundation": "^6.4 || ^7.4 || ^8.0",
    "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0",
    "symfony/mailer": "^6.4 || ^7.4 || ^8.0",
    "symfony/mime": "^6.4 || ^7.4 || ^8.0",
    "symfony/routing": "^6.4 || ^7.4 || ^8.0",
    "symfony/security-core": "^6.4 || ^7.4 || ^8.0",
    "symfony/translation": "^6.4 || ^7.4 || ^8.0",
    "symfony/translation-contracts": "^3.0",
    "symfony/twig-bridge": "^6.4 || ^7.4 || ^8.0",
    "symfony/yaml": "^6.4 || ^7.4 || ^8.0",
    "twig/twig": "^3.8"
  },
  "suggest": {
    "isotope/isotope-core": "To match declarations with Isotope orders",
    "terminal42/notification_center": "To send the confirmation messages through the Notification Center"
  },
  "conflict": {
    "contao/manager-plugin": "<2.0 || >=3.0"
  },
  "require-dev": {
    "contao/manager-plugin": "^2.0",
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "Pdir\\ContaoRightOfWithdrawalBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pdir\\ContaoRightOfWithdrawalBundle\\Tests\\": "tests/"
    }
  },
  "extra": {
    "contao-manager-plugin": "Pdir\\ContaoRightOfWithdrawalBundle\\ContaoManager\\Plugin"
  },
  "config": {
    "allow-plugins": {
      "contao-components/installer": true,
      "php-http/discovery": true,
      "contao/manager-plugin": true
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
